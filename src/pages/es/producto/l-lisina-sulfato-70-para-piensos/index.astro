const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/product/l-lysine-sulphate-70-feed-grade/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/product/l-lysine-sulphate-70-feed-grade/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d9%86%d8%aa%d8%ac/%d9%84-%d9%84%d9%8a%d8%b3%d9%8a%d9%86-%d8%b3%d9%84%d9%81%d8%a7%d8%aa-%d9%84%d9%8a%d8%b3%d9%8a%d9%86-70-%d8%af%d8%b1%d8%ac%d8%a9-%d8%a7%d9%84%d8%b9%d9%84%d9%81/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/produit/sulfate-de-lysine-70-qualite-fourragere/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/urun/lizin-sulfat-70-yem-sinifi/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/producto/l-lisina-sulfato-70-para-piensos/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/produkt/l-lysinsulfat-70-futtermittelqualitat/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e4%ba%a7%e5%93%81/%e8%b5%96%e6%b0%a8%e9%85%b8%e7%a1%ab%e9%85%b8%e7%9b%90-70-%e9%a5%b2%e6%96%99%e7%ba%a7/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/produto/l-lysine-sulphate-70-feed-grade/'/>";
