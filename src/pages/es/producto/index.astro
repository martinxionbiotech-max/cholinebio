---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Productos",
};

const products = [
  { title: "Aditivo alimentario de fitasa termoestable — Alta actividad (5.000–300.000 U/g)", cat: "Feed Additive", href: "/es/producto/aditivo-para-piensos-a-base-de-fitasa-termoestable/", img: "/images/uploads/2025/09/Feed-Additive-Application1-1024x1024.jpg" },
  { title: "Betaína anhidra: el aditivo para piensos más vendido, suministrado directamente por el fabricante", cat: "Feed Additive", href: "/es/producto/betaina-anhidra/", img: "/images/uploads/2025/08/IMG_0269-1024x1024.jpg" },
  { title: "Clorhidrato de betaína – Suministro directo del fabricante de aditivos para piensos", cat: "Feed Additive", href: "/es/producto/clorhidrato-de-betaina-para-piensos/", img: "/images/uploads/2025/08/IMG_0272-1024x1024.jpg" },
  { title: "Aditivo alimentario cloruro de colina 50% – Soporte de mazorca de maíz", cat: "Feed Additive", href: "/es/producto/cloruro-de-colina-50/", img: "/images/uploads/2025/08/IMG_0275-1024x1024.jpg" },
  { title: "Aditivo alimentario cloruro de colina 60% – Suministro por parte de un fabricante chino con soporte de mazorca de maíz", cat: "Feed Additive", href: "/es/producto/cloruro-de-colina-60/", img: "/images/uploads/2025/08/IMG_0274-1024x1024.jpg" },
  { title: "Cloruro de colina 75% – Aditivo alimentario líquido de alta pureza, líder en ventas", cat: "Feed Additive", href: "/es/producto/cloruro-de-colina-75-liquido/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "(DCP) Fosfato dicálcico 18% en polvo – Aditivo para piensos", cat: "Feed Additive", href: "/es/producto/dcp-18-polvo/", img: "/images/uploads/2025/09/DCP18-powder-2-1024x1024.jpg" },
  { title: "Enzima fitasa — Aditivo alimentario en polvo más vendido", cat: "Feed Additive", href: "/es/producto/enzima-fitasa-polvo-para-piensos/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-1024x1024.jpg" },
  { title: "(DCP) Fosfato dicálcico 17% en polvo – Aditivo para piensos", cat: "Feed Additive", href: "/es/producto/fosfato-dicalcico-17/", img: "/images/uploads/2025/09/DCP17-4-1024x1024.jpg" },
  { title: "Sulfato de L-lisina 70% (calidad para piensos) — Aditivo de aminoácidos para la nutrición animal", cat: "Feed Additive", href: "/es/producto/l-lisina-sulfato-70-para-piensos/", img: "/images/uploads/2025/09/1-1024x1024.jpg" },
  { title: "Aditivo alimentario de vitamina B12 en polvo (mecobalamina)", cat: "Feed Additive", href: "/es/producto/vitamina-b12-en-polvo-mecobalamina-para-piensos/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" },
  { title: "Vitamina B2 en polvo (riboflavina) – Aditivo alimentario más vendido", cat: "Feed Additive", href: "/es/producto/vitamina-b2-en-polvo-riboflavina-aditivo-para-piensos/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-1024x1024.jpg" },
  { title: "Vitamina C (ácido ascórbico), el aditivo para piensos más vendido – 25 kg/caja", cat: "Feed Additive", href: "/es/producto/vitamina-c-acido-ascorbico-para-piensos-99/", img: "/images/uploads/2025/09/IMG_0271-1024x1024.jpg" }
];
---

<BaseLayout title={page.title} lang="es" description="Feed-grade additives for animal nutrition — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes." canonical="/es/producto/">
  <div class="container section">
    <span class="kicker">Productos</span>
    <h1 class="sec-title">Productos</h1>
    <p class="sec-sub">Feed-grade additives for animal nutrition.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
