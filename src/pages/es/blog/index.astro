---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Blog",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "Precio de la cloruro de colina en China en 2025 por tonelada: tendencias y previsiones del mercado", href: "/es/2025-china-cloruro-de-colina-precio-por-tonelada/" },
  { title: "Pienso con cloruro de colina: 5 aspectos clave que debes saber antes de comprarlo", href: "/es/alimentacion-con-cloruro-de-colina-5-claves-que-debe-conocer/" },
  { title: "El cloruro de colina en la comida para gatos: funciones esenciales, beneficios y comparación con la nutrición canina", href: "/es/cloruro-de-colina-en-la-comida-para-gatos/" },
  { title: "El cloruro de colina en la comida para perros: funciones, beneficios y aspectos a tener en cuenta", href: "/es/cloruro-de-colina-en-los-alimentos-para-perros/" },
  { title: "El cloruro de colina en la alimentación avícola: ¡lo que debes saber!", href: "/es/cloruro-de-colina-en-los-piensos-para-aves-de-corral/" },
  { title: "Colina e inositol: aditivos para piensos", href: "/es/colina-e-inositol/" },
  { title: "¿Qué es el cloruro de colina? ¿Cómo se fabrica en China?", href: "/es/que-es-el-cloruro-de-colina-guia-de-fabricacion-en-china/" },
  { title: "¿Qué es el fosfato dicálcico? La información más completa que necesitas", href: "/es/que-es-el-fosfato-dicalcico/" },
  { title: "¿Qué son los aditivos fitogénicos para piensos? Comparación del cloruro de colina", href: "/es/que-son-los-aditivos-fitogenicos-para-piensos/" }
];
---

<BaseLayout title={page.title} hreflang={hreflang} lang="es-ES" description="Feed additive industry insights" canonical="/es/blog/">
  <div class="container section">
    <span class="kicker">Blog</span>
    <h1 class="sec-title">Blog</h1>
    <p class="sec-sub">Practical guides on choline chloride, dicalcium phosphate, vitamins and amino acids.</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>Read article →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
