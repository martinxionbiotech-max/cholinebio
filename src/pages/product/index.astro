---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Products",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/product/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/product/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d9%86%d8%aa%d8%ac/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/produit/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/urun/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/producto/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/produkt/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e4%ba%a7%e5%93%81/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/produto/'/>";

const products = [
  { title: "Choline Chloride 60% Feed Additive – Corn Cob Carrier", cat: "Choline Chloride", href: "/product/choline-chloride-60/", img: "/images/uploads/2025/08/IMG_0274-768x768.jpg" },
  { title: "Choline Chloride 50% Feed Additive – Corn Cob Carrier", cat: "Choline Chloride", href: "/product/choline-chloride-50/", img: "/images/uploads/2025/08/IMG_0275-768x768.jpg" },
  { title: "Choline Chloride 75% – High Purity Liquid Feed Additive", cat: "Choline Chloride", href: "/product/choline-chloride-75-liquid/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "Betaine Anhydrous – Feed Additive", cat: "Betaine", href: "/product/betaine-anhydrous/", img: "/images/uploads/2025/08/IMG_0269-768x768.jpg" },
  { title: "Betaine Hydrochloride – Feed Additive", cat: "Betaine", href: "/product/betaine-hydrochloride-feed-grade/", img: "/images/uploads/2025/08/IMG_0272-768x768.jpg" },
  { title: "(DCP) Dicalcium Phosphate 18% Powder – Feed Additive", cat: "Minerals For Feed", href: "/product/dcp-18-powder/", img: "/images/uploads/2025/09/DCP18-powder-2-768x768.jpg" },
  { title: "(DCP) Dicalcium Phosphate 17% Powder – Feed Additive", cat: "Minerals For Feed", href: "/product/dcp-dicalcium-phosphate-17/", img: "/images/uploads/2025/09/DCP17-4-768x768.jpg" },
  { title: "L-Lysine Sulphate 70% (Feed Grade)", cat: "Amino Acids", href: "/product/l-lysine-sulphate-70-feed-grade/", img: "/images/uploads/2025/09/1-768x768.jpg" },
  { title: "Vitamin B2 Powder (Riboflavin) – Feed Additive", cat: "Vitamins", href: "/product/vitamin-b2-powder-riboflavin-feed-additive/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-768x768.jpg" },
  { title: "Vitamin B12 Powder (Mecobalamin) Feed Additive", cat: "Vitamins", href: "/product/feed-grade-vitamin-b12-powder-mecobalamin/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" },
  { title: "Vitamin C (Ascorbic Acid) Feed Additive", cat: "Vitamins", href: "/product/vitamin-c-ascorbic-acid-feed-grade-99/", img: "/images/uploads/2025/09/IMG_0271-768x768.jpg" },
  { title: "Heat-Stable Phytase Feed Additive", cat: "Enzyme Preparation", href: "/product/heat-stable-phytase-feed-additive/", img: "/images/uploads/2025/09/Feed-Additive-Application1-768x768.jpg" },
  { title: "Phytase Enzyme – Feed Additive Powder", cat: "Enzyme Preparation", href: "/product/phytase-enzyme-feed-grade-powder/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-768x768.jpg" },
];
---

<BaseLayout title={page.title} hreflang={hreflang} description="Feed-grade additives sourced from certified Chinese manufacturers — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes for poultry, swine, ruminant, and aquaculture nutrition." canonical="/product/">
  <div class="container section">
    <span class="kicker">Products</span>
    <h1 class="sec-title">Feed Additives</h1>
    <p class="sec-sub">High-quality feed-grade additives for animal nutrition, sourced directly from ISO-certified Chinese manufacturers.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
