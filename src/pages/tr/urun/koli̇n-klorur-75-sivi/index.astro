const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/product/choline-chloride-75-liquid/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/product/choline-chloride-75-liquid/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d9%86%d8%aa%d8%ac/%d9%83%d9%84%d9%88%d8%b1%d9%8a%d8%af-%d8%a7%d9%84%d9%83%d9%88%d9%84%d9%8a%d9%86-75-%d8%b3%d8%a7%d8%a6%d9%84/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/produit/chlorure-de-choline-75-liquide/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/urun/koli%cc%87n-klorur-75-sivi/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/producto/cloruro-de-colina-75-liquido/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/produkt/cholinchlorid-75-flussig/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e4%ba%a7%e5%93%81/%e6%b0%af%e5%8c%96%e8%83%86%e7%a2%b1-75-%e6%b6%b2%e4%bd%93/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/produto/cloreto-de-colina-75-liquido/'/>";
