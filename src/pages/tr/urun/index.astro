---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Ürünler",
};

const products = [
  { title: "B2 Vitamini Tozu (Riboflavin) – En Çok Satan Yem Katkısı", cat: "Feed Additive", href: "/tr/urun/b2-vitamini-tozu-riboflavin-yem-katki-maddesi/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-768x768.jpg" },
  { title: "Betain Hidroklorür – Yem Katkı Maddesi Doğrudan Üretici Tedariği", cat: "Feed Additive", href: "/tr/urun/betain-hidroklorur-yem-sinifi/", img: "/images/uploads/2025/08/IMG_0272-768x768.jpg" },
  { title: "Susuz Betain – En Çok Satan Yem Katkısı – Doğrudan Üreticiden Tedarik", cat: "Feed Additive", href: "/tr/urun/betain-susuz/", img: "/images/uploads/2025/08/IMG_0269-768x768.jpg" },
  { title: "C Vitamini (Askorbik Asit) En Çok Satan Yem Katkısı – 25 kg/Karton", cat: "Feed Additive", href: "/tr/urun/c-vitamini-askorbik-asit-yem-sinifi-�/", img: "/images/uploads/2025/09/IMG_0271-768x768.jpg" },
  { title: "(DCP) Dikalsiyum Fosfat 18% Toz – Yem Katkı Maddesi", cat: "Feed Additive", href: "/tr/urun/dcp-18-toz/", img: "/images/uploads/2025/09/DCP18-powder-2-768x768.jpg" },
  { title: "(DCP) Dikalsiyum Fosfat 17% Toz – Yem Katkı Maddesi", cat: "Feed Additive", href: "/tr/urun/dcp-di̇kalsi̇yum-fosfat-17/", img: "/images/uploads/2025/09/DCP17-4-768x768.jpg" },
  { title: "Fitataz Enzimi — En Çok Satan Yem Katkı Maddesi Tozu", cat: "Feed Additive", href: "/tr/urun/fitaz-enzimi-yem-sinifi-toz/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-768x768.jpg" },
  { title: "Isıya Dayanıklı Fitaz Yem Katkısı — Yüksek Aktivite (5.000–300.000 U/g)", cat: "Feed Additive", href: "/tr/urun/isiya-dayanikli-fitaz-yem-katki-maddesi/", img: "/images/uploads/2025/09/Feed-Additive-Application1-768x768.jpg" },
  { title: "Kolin Klorür 60% Yem Katkısı – Mısır Koçanı Taşıyıcılı Çin Üreticisi Tedariği", cat: "Feed Additive", href: "/tr/urun/kolin-klorur-60/", img: "/images/uploads/2025/08/IMG_0274-768x768.jpg" },
  { title: "Kolin Klorür 50% Yem Katkısı – Mısır Koçanı Taşıyıcı", cat: "Feed Additive", href: "/tr/urun/kolin-klorur-p/", img: "/images/uploads/2025/08/IMG_0275-768x768.jpg" },
  { title: "Kolin Klorür 75% – Yüksek Saflıkta Sıvı, En Çok Satan Yem Katkısı", cat: "Feed Additive", href: "/tr/urun/koli̇n-klorur-75-sivi/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "L-Lizin Sülfat 70% (Yem Sınıfı) — Hayvan Beslenmesi için Amino Asit Katkısı", cat: "Feed Additive", href: "/tr/urun/lizin-sulfat-70-yem-sinifi/", img: "/images/uploads/2025/09/1-768x768.jpg" },
  { title: "B12 Vitamini Tozu (Mekobalamin) Yem Katkı Maddesi", cat: "Feed Additive", href: "/tr/urun/yem-sinifi-b12-vi̇tami̇ni̇-toz-mekobalami̇n/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" }
];
---

<BaseLayout title={page.title} lang="tr" description="Feed-grade additives for animal nutrition — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes." canonical="/tr/urun/">
  <div class="container section">
    <span class="kicker">Ürünler</span>
    <h1 class="sec-title">Ürünler</h1>
    <p class="sec-sub">Feed-grade additives for animal nutrition.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
