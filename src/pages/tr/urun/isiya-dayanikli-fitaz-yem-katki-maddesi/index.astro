const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/product/heat-stable-phytase-feed-additive/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/product/heat-stable-phytase-feed-additive/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d9%86%d8%aa%d8%ac/%d9%85%d8%b6%d8%a7%d9%81%d8%a7%d8%aa-%d8%a3%d8%b9%d9%84%d8%a7%d9%81-%d8%a7%d9%84%d9%81%d9%8a%d8%aa%d8%a7%d8%b2-%d8%a7%d9%84%d9%85%d8%b3%d8%aa%d9%82%d8%b1%d8%a9-%d8%ad%d8%b1%d8%a7%d8%b1%d9%8a%d8%a7/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/produit/phytase-thermostable-additif-pour-lalimentation-animale/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/urun/isiya-dayanikli-fitaz-yem-katki-maddesi/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/producto/aditivo-para-piensos-a-base-de-fitasa-termoestable/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/produkt/hitzestabiler-phytase-futtermittelzusatz/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e4%ba%a7%e5%93%81/%e7%83%ad%e7%a8%b3%e5%ae%9a%e6%a4%8d%e9%85%b8%e9%85%b6%e9%a5%b2%e6%96%99%e6%b7%bb%e5%8a%a0%e5%89%82/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/produto/aditivo-para-racoes-com-fitase-estavel-ao-calor/'/>";
