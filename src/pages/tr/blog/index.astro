---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Blog",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "2025 Yılı Çin Kolin Klorür Ton Başına Fiyatı: Piyasa Eğilimleri ve Tahminleri", href: "/tr/2025-cin-kolin-klorur-ton-basina-fiyat/" },
  { title: "Dikalsiyum Fosfat Nedir? İhtiyacınız Olan En Kapsamlı Bilgiler", href: "/tr/di̇kalsi̇yum-fosfat-nedi̇r/" },
  { title: "Fitojenik Yem Katkı Maddeleri Nedir? Kolin Klorür Karşılaştırması", href: "/tr/fitojenik-yem-katki-maddeleri-nelerdir/" },
  { title: "Kümes Hayvanları Yemlerinde Kolin Klorür – Bilmeniz Gerekenler!", href: "/tr/kanatli-yemlerinde-kolin-klorur/" },
  { title: "Kedi Mamalarında Kolin Klorür: Temel İşlevleri, Faydaları ve Köpek Beslenmesiyle Karşılaştırması", href: "/tr/kedi̇-mamasinda-koli̇n-klorur/" },
  { title: "Kolin Klorür Nedir? Çin’de Nasıl Üretilir?", href: "/tr/kolin-klorur-nedir-cin-uretim-kilavuzu/" },
  { title: "Kolin ve İnositol: Hayvan Yemi Katkı Maddelerinde", href: "/tr/kolin-ve-inositol/" },
  { title: "Kolin Klorür Yemi: Satın Almadan Önce Bilmeniz Gereken 5 Önemli Nokta", href: "/tr/koli̇n-klorur-yemi̇-bi̇lmeni̇z-gereken-5-anahtar/" },
  { title: "Köpek Mamalarında Kolin Klorür: İşlevleri, Faydaları ve Dikkat Edilmesi Gerekenler", href: "/tr/kopek-mamasinda-koli̇n-klorur/" }
];
---

<BaseLayout title={page.title} hreflang={hreflang} lang="tr-TR" description="Feed additive industry insights" canonical="/tr/blog/">
  <div class="container section">
    <span class="kicker">Blog</span>
    <h1 class="sec-title">Blog</h1>
    <p class="sec-sub">Practical guides on choline chloride, dicalcium phosphate, vitamins and amino acids.</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>Read article →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
