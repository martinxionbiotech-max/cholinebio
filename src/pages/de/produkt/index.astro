---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Produkte",
};

const products = [
  { title: "Wasserfreies Betain – Der meistverkaufte Futterzusatzstoff direkt vom Hersteller", cat: "Feed Additive", href: "/de/produkt/betain-wasserfrei/", img: "/images/uploads/2025/08/IMG_0269-768x768.jpg" },
  { title: "Betainhydrochlorid – Direktlieferung vom Hersteller von Futtermittelzusatzstoffen", cat: "Feed Additive", href: "/de/produkt/betainhydrochlorid-in-futtermittelqualitat/", img: "/images/uploads/2025/08/IMG_0272-768x768.jpg" },
  { title: "Cholinchlorid 50% – Futtermittelzusatzstoff – Maiskolben als Trägerstoff", cat: "Feed Additive", href: "/de/produkt/cholinchlorid-50/", img: "/images/uploads/2025/08/IMG_0275-768x768.jpg" },
  { title: "Cholinchlorid 60% als Futtermittelzusatzstoff – Lieferant von Trägersubstanz aus Maiskolben in China", cat: "Feed Additive", href: "/de/produkt/cholinchlorid-60/", img: "/images/uploads/2025/08/IMG_0274-768x768.jpg" },
  { title: "Cholinchlorid 75% – Hochreines flüssiges, meistverkauftes Futtermittelzusatzmittel", cat: "Feed Additive", href: "/de/produkt/cholinchlorid-75-flussig/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "(DCP) Dicalciumphosphat 18% Pulver – Futtermittelzusatzstoff", cat: "Feed Additive", href: "/de/produkt/dcp-18-pulver/", img: "/images/uploads/2025/09/DCP18-powder-2-768x768.jpg" },
  { title: "(DCP) Dicalciumphosphat 17% Pulver – Futtermittelzusatzstoff", cat: "Feed Additive", href: "/de/produkt/dcp-dicalciumphosphat-17/", img: "/images/uploads/2025/09/DCP17-4-768x768.jpg" },
  { title: "Hitzestabiler Phytase-Futterzusatzstoff – hohe Aktivität (5.000–300.000 U/g)", cat: "Feed Additive", href: "/de/produkt/hitzestabiler-phytase-futtermittelzusatz/", img: "/images/uploads/2025/09/Feed-Additive-Application1-768x768.jpg" },
  { title: "L-Lysinsulfat 70% (Futtermittelqualität) – Aminosäurezusatzstoff für die Tierernährung", cat: "Feed Additive", href: "/de/produkt/l-lysinsulfat-70-futtermittelqualitat/", img: "/images/uploads/2025/09/1-768x768.jpg" },
  { title: "Phytase-Enzym – Das meistverkaufte Futtermittelzusatzmittel in Pulverform", cat: "Feed Additive", href: "/de/produkt/phytase-enzym-pulver-in-futtermittelqualitat/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-768x768.jpg" },
  { title: "Vitamin-B12-Pulver (Mecobalamin) als Futtermittelzusatzstoff", cat: "Feed Additive", href: "/de/produkt/vitamin-b12-pulver-in-futtermittelqualitat-mecobalamin/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" },
  { title: "Vitamin B2-Pulver (Riboflavin) – Bestseller unter den Futtermittelzusatzstoffen", cat: "Feed Additive", href: "/de/produkt/vitamin-b2-pulver-riboflavin-futtermittelzusatz/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-768x768.jpg" },
  { title: "Vitamin C (Ascorbinsäure) – meistverkaufter Futterzusatzstoff – 25 kg/Karton", cat: "Feed Additive", href: "/de/produkt/vitamin-c-ascorbinsaure-futtermittelqualitat-99/", img: "/images/uploads/2025/09/IMG_0271-768x768.jpg" }
];
---

<BaseLayout title={page.title} lang="de" description="Feed-grade additives for animal nutrition — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes." canonical="/de/produkt/">
  <div class="container section">
    <span class="kicker">Produkte</span>
    <h1 class="sec-title">Produkte</h1>
    <p class="sec-sub">Feed-grade additives for animal nutrition.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
