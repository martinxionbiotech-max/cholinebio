---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Blog",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "Cholinchlorid-Preis pro Tonne in China 2025: Markttrends und Prognosen", href: "/de/2025-cholinchlorid-preis-pro-tonne/" },
  { title: "Cholin und Inositol: als Futtermittelzusatzstoffe", href: "/de/cholin-und-inositol/" },
  { title: "Cholinchlorid als Futterzusatz: 5 wichtige Dinge, die Sie vor dem Kauf wissen müssen", href: "/de/cholinchlorid-futtermittel-5-schlussel-die-sie-kennen-mussen/" },
  { title: "Cholinchlorid in Geflügelfutter – Was Sie wissen müssen!", href: "/de/cholinchlorid-in-geflugelfutter/" },
  { title: "Cholinchlorid in Hundefutter: Funktionen, Vorteile und zu beachtende Aspekte", href: "/de/cholinchlorid-in-hundefutter/" },
  { title: "Cholinchlorid in Katzenfutter: Wesentliche Funktionen, Vorteile und Vergleich mit der Hundeernährung", href: "/de/cholinchlorid-in-katzenfutter/" },
  { title: "Was ist Cholinchlorid? Wie wird es in China hergestellt?", href: "/de/was-ist-cholinchlorid-leitfaden-zur-herstellung-in-china/" },
  { title: "Was ist Dicalciumphosphat? Die umfassendsten Informationen, die Sie benötigen", href: "/de/was-ist-dicalciumphosphat/" },
  { title: "Was sind phytogene Futterzusatzstoffe? Vergleich von Cholinchlorid", href: "/de/was-sind-phytogene-futtermittelzusatzstoffe/" }
];
---

<BaseLayout title={page.title} hreflang={hreflang} lang="de-DE" description="Feed additive industry insights" canonical="/de/blog/">
  <div class="container section">
    <span class="kicker">Blog</span>
    <h1 class="sec-title">Blog</h1>
    <p class="sec-sub">Practical guides on choline chloride, dicalcium phosphate, vitamins and amino acids.</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>Read article →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
