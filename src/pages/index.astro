---
import BaseLayout from "../layouts/BaseLayout.astro";

const page = {
  title: "Dinweys Biotech – Feed Additives Export & Global Distribution",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/'/>";
---

<BaseLayout title={page.title} hreflang={hreflang} description="Export & International Sales Partner for China Feed Additives" canonical="/">
  <section class="hero">
    <div class="container">
      <h1>High-Quality Feed Additives Supplier from China</h1>
      <p class="lead">Dinweys Biotech is the dedicated global sales and export division for qualified feed additive manufacturers — supplying choline chloride, betaine, dicalcium phosphate, amino acids, and vitamins to farms and feed companies worldwide.</p>
      <div class="hero-actions">
        <a class="btn white" href="/product/">Explore Products</a>
        <a class="btn ghost-hero" href="/contact/">Get a Quote</a>
      </div>
      <div class="hero-stats">
        <div><b>20+</b><span>Countries Export To</span></div>
        <div><b>100+</b><span>Clients Worldwide</span></div>
        <div><b>ISO·HACCP·FAMI-QS</b><span>Certified Facilities</span></div>
      </div>
    </div>
  </section>

  <div class="container">
    <!-- Product Categories -->
    <section class="section">
      <span class="kicker">Product Range</span>
      <h2 class="sec-title">Our Feed Additive Categories</h2>
      <p class="sec-sub">From choline chloride to feed enzymes — sourced direct from certified Chinese manufacturers, with full documentation and export support.</p>
      <div class="card-grid">
        <div class="card">
          <div class="body">
            <span class="cat">Vitamins</span>
            <h3><a href="/product_category/choline-chloride/">Choline Chloride Feed</a></h3>
            <p>60% corn cob, 60% silica, 50% corn cob, and 75% liquid — a core Vitamin B4 supplement for poultry, swine, and aquaculture.</p>
            <a class="link" href="/product_category/choline-chloride/">View products →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">Vitamins</span>
            <h3><a href="/product_category/vitamins/">Vitamins Feed Powder</a></h3>
            <p>Riboflavin (B2), Ascorbic Acid (C), and more — feed-grade vitamins for balanced animal nutrition.</p>
            <a class="link" href="/product_category/vitamins/">View products →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">Minerals</span>
            <h3><a href="/product_category/minerals-for-feed-and-food/">Minerals For Feed</a></h3>
            <p>Dicalcium Phosphate (DCP 17% &amp; 18%) and mineral additives for skeletal development and production performance.</p>
            <a class="link" href="/product_category/minerals-for-feed-and-food/">View products →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">Amino Acids</span>
            <h3><a href="/product_category/amino-acids/">Amino Acids Feed</a></h3>
            <p>L-Lysine Sulphate 70%, DL-Methionine, L-Threonine — essential amino acids for optimized feed formulation.</p>
            <a class="link" href="/product_category/amino-acids/">View products →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">Enzymes</span>
            <h3><a href="/product_category/enzyme-preparation/">Feed Enzyme Preparation</a></h3>
            <p>Heat-stable phytase and granular phytase to improve phosphorus availability and feed efficiency.</p>
            <a class="link" href="/product_category/enzyme-preparation/">View products →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="section">
      <span class="kicker">Quality Assurance</span>
      <h2 class="sec-title">Certified Manufacturing Partners</h2>
      <p class="sec-sub">Our partner facilities hold internationally recognized quality and safety certifications for feed-grade additive production and export compliance.</p>
      <div class="card-grid">
        <div class="card plain text-center">
          <h3>ISO 9001</h3>
          <p class="muted small">Quality management system</p>
        </div>
        <div class="card plain text-center">
          <h3>ISO 22000</h3>
          <p class="muted small">Food safety management</p>
        </div>
        <div class="card plain text-center">
          <h3>HACCP</h3>
          <p class="muted small">Hazard analysis &amp; critical control points</p>
        </div>
        <div class="card plain text-center">
          <h3>FAMI-QS</h3>
          <p class="muted small">Feed additive quality standard (Europe)</p>
        </div>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="section">
      <span class="kicker">Why Choose Us</span>
      <h2 class="sec-title">Your Trusted Feed Additive Sourcing Partner</h2>
      <div class="card-grid">
        <div class="card">
          <div class="body">
            <h3>Export &amp; Communication Advantage</h3>
            <p>Designated export and sales partner for qualified manufacturers, providing consistent international communication and export documentation support.</p>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3>Product &amp; Market Support</h3>
            <p>Assistance with product specifications, regulatory information, and logistics coordination — so you focus on feed formulation.</p>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3>Reliable Global Delivery</h3>
            <p>Timely delivery, clear export procedures, and dependable service through deep cooperation with our partner factory.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- CTA band -->
  <div class="container">
    <section class="cta-band">
      <h2>Ready to Source Quality Feed Additives?</h2>
      <p>Get competitive pricing, COA documentation, and reliable export logistics for choline chloride, betaine, DCP, amino acids, and vitamins.</p>
      <a class="btn" href="/contact/">Contact Our Sales Team</a>
    </section>
  </div>
</BaseLayout>
