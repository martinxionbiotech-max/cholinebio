import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Política de Privacidade",
  h1: "Política de Privacidade",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/privacy-policy/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/privacy-policy/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%b3%d9%8a%d8%a7%d8%b3%d8%a9-%d8%a7%d9%84%d8%ae%d8%b5%d9%88%d8%b5%d9%8a%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/politique-de-confidentialite/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/gizlilik-politikasi/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/politica-de-privacidad/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/datenschutzbestimmungen/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e9%9a%90%e7%a7%81%e6%94%bf%e7%ad%96/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/politica-de-privacidade/'/>";
---
<BaseLayout title={page.title} ogType="website" description="Bem-vindo ao ColinaBio (“nós”, “nosso”, “nos”). Temos o compromisso de proteger suas informações pessoais e garantir a transparência em relação à forma..." canonical="/pt/politica-de-privacidade/" lang="pt-BR" hreflang={hreflang}>
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<header class="entry-header page-title title-align-inherit title-tablet-align-inherit title-mobile-align-inherit"><h1 class="entry-title">Política de privacidade</h1><nav id="kadence-breadcrumbs" aria-label="Migalhas de pão"  class="kadence-breadcrumbs" data-no-translation-aria-label=""><div class="kadence-breadcrumb-container"><span><a href="/pt/" itemprop="url" class="kadence-bc-home" ><span data-no-translation="" data-trp-gettext="">Início</span></a></span> <span class="bc-delimiter">/</span> <span class="kadence-bread-current">Política de privacidade</span></div></nav></header><div class="entry-content single-content"><p data-start="173" data-end="211"><strong data-start="173" data-end="211">Data de vigência: 22 de setembro de 2025</strong></p><p data-start="213" data-end="476">Bem-vindo ao <strong data-start="224" data-end="238">ColinaBio</strong> (“nós”, “nosso”, “nos”). Temos o compromisso de proteger suas informações pessoais e garantir a transparência em relação à forma como coletamos, usamos, armazenamos e compartilhamos dados quando você visita <strong data-start="411" data-end="438"><a class="decorated-link" href="/" target="_new" rel="noopener" data-start="413" data-end="436">/</a></strong> ou se envolver com nossos serviços comerciais.</p><hr data-start="478" data-end="481" /><h1 data-start="483" data-end="507"><strong data-start="485" data-end="507">1. Controlador de dados</strong></h1><p data-start="508" data-end="536">Este site é operado por:</p><p data-start="538" data-end="658"><strong data-start="538" data-end="555">Nome da empresa:</strong> Dinweys (empresa de vendas para exportação)<br data-start="586" data-end="589" /><strong data-start="589" data-end="601">Site:</strong> <a class="decorated-link" href="" target="_new" rel="noopener" data-start="602" data-end="624"></a><br data-start="624" data-end="627" /><strong data-start="627" data-end="637">E-mail:</strong> <a class="decorated-link cursor-pointer" rel="noopener" data-start="638" data-end="656"><span class="__cf_email__" data-cfemail="3d505c4f4954537d5954534a58444e135e5250">[email&#160;protected]</span></a></p><p data-start="660" data-end="757">Se você estiver localizado na UE/EEE, a Dinweys atuará como a <strong data-start="714" data-end="733">controlador de dados</strong> para seus dados pessoais.</p><hr data-start="759" data-end="762" /><h1 data-start="764" data-end="795"><strong data-start="766" data-end="795">2. Informações que coletamos</strong></h1><p data-start="796" data-end="846">Podemos coletar os seguintes tipos de informações:</p><h3 data-start="848" data-end="882"><strong data-start="852" data-end="882">A. Informações fornecidas pelo usuário</strong></h3><p data-start="883" data-end="900">Os exemplos incluem:</p><ul data-start="902" data-end="1090"><li data-start="902" data-end="910"><p data-start="904" data-end="910">Nome</p></li><li data-start="911" data-end="928"><p data-start="913" data-end="928">Endereço de e-mail</p></li><li data-start="929" data-end="945"><p data-start="931" data-end="945">Número de telefone</p></li><li data-start="946" data-end="979"><p data-start="948" data-end="979">Nome da empresa e cargo</p></li><li data-start="980" data-end="991"><p data-start="982" data-end="991">Endereço</p></li><li data-start="992" data-end="1043"><p data-start="994" data-end="1043">Consultas comerciais, solicitações de cotação, detalhes relacionados a pedidos</p></li><li data-start="1044" data-end="1090"><p data-start="1046" data-end="1090">Credenciais de login (se você criar uma conta)</p></li></ul><h3 data-start="1092" data-end="1131"><strong data-start="1096" data-end="1131">B. Dados coletados automaticamente</strong></h3><p data-start="1132" data-end="1178">Coletados por meio de cookies e ferramentas de análise:</p><ul data-start="1180" data-end="1345"><li data-start="1180" data-end="1194"><p data-start="1182" data-end="1194">Endereço IP</p></li><li data-start="1195" data-end="1232"><p data-start="1197" data-end="1232">Tipo de navegador e sistema operacional</p></li><li data-start="1233" data-end="1255"><p data-start="1235" data-end="1255">Informações sobre o dispositivo</p></li><li data-start="1256" data-end="1287"><p data-start="1258" data-end="1287">Páginas visualizadas e tempo gasto</p></li><li data-start="1288" data-end="1306"><p data-start="1290" data-end="1306">URLs de referência</p></li><li data-start="1307" data-end="1345"><p data-start="1309" data-end="1345">Dados gerais de uso e interação</p></li></ul><h3 data-start="1347" data-end="1388"><strong data-start="1351" data-end="1388">C. Informações de terceiros</strong></h3><p data-start="1389" data-end="1421">Podemos receber informações de:</p><ul data-start="1423" data-end="1583"><li data-start="1423" data-end="1499"><p data-start="1425" data-end="1499">Mercados B2B (por exemplo, Alibaba, Made-in-China), se você entrar em contato conosco por lá</p></li><li data-start="1500" data-end="1526"><p data-start="1502" data-end="1526">Plataformas de mídia social</p></li><li data-start="1527" data-end="1583"><p data-start="1529" data-end="1583">Prestadores de serviços de logística ou de pagamento que você autorizar</p></li></ul><hr data-start="1585" data-end="1588" /><h1 data-start="1590" data-end="1626"><strong data-start="1592" data-end="1626">3. Como usamos suas informações</strong></h1><p data-start="1627" data-end="1659">Podemos usar suas informações para:</p><ul data-start="1661" data-end="2004"><li data-start="1661" data-end="1725"><p data-start="1663" data-end="1725">Responder a RFQs, consultas e solicitações de atendimento ao cliente</p></li><li data-start="1726" data-end="1770"><p data-start="1728" data-end="1770">Processamento de pedidos e prestação de serviços</p></li><li data-start="1771" data-end="1826"><p data-start="1773" data-end="1826">Melhorar a funcionalidade do site e a experiência do usuário</p></li><li data-start="1827" data-end="1923"><p data-start="1829" data-end="1923">Envio de atualizações, informações comerciais ou comunicações de marketing (quando legalmente permitido)</p></li><li data-start="1924" data-end="1967"><p data-start="1926" data-end="1967">Verificação de identidade e prevenção de fraudes</p></li><li data-start="1968" data-end="2004"><p data-start="1970" data-end="2004">Cumprir com as obrigações legais</p></li></ul><p data-start="2006" data-end="2115">Sempre processamos dados com base em um fundamento legal (por exemplo, interesse legítimo, consentimento ou execução de contrato).</p><hr data-start="2117" data-end="2120" /><h1 data-start="2122" data-end="2155"><strong data-start="2124" data-end="2155">4. Compartilhamento de suas informações</strong></h1><p data-start="2156" data-end="2248">Fazemos <strong data-start="2162" data-end="2169">não</strong> vender seus dados pessoais. Podemos compartilhar informações somente nos seguintes casos:</p><ul data-start="2250" data-end="2510"><li data-start="2250" data-end="2355"><p data-start="2252" data-end="2355"><strong data-start="2252" data-end="2273">Provedores de serviços</strong> (provedores de hospedagem, segurança de TI, logística, provedores de serviços de e-mail, análises)</p></li><li data-start="2356" data-end="2446"><p data-start="2358" data-end="2446"><strong data-start="2358" data-end="2378">Conformidade legal</strong> (solicitações governamentais, procedimentos legais, requisitos regulatórios)</p></li><li data-start="2447" data-end="2510"><p data-start="2449" data-end="2510"><strong data-start="2449" data-end="2471">Transferências de negócios</strong> (fusão, aquisição, reestruturação)</p></li></ul><p data-start="2512" data-end="2604">Todos os provedores de serviços são obrigados a proteger suas informações de acordo com os acordos contratuais.</p><hr data-start="2606" data-end="2609" /><h1 data-start="2611" data-end="2651"><strong data-start="2613" data-end="2651">5. Cookies e tecnologias de rastreamento</strong></h1><p data-start="2652" data-end="2695">Usamos cookies e tecnologias relacionadas para:</p><ul data-start="2697" data-end="2850"><li data-start="2697" data-end="2728"><p data-start="2699" data-end="2728">Melhorar o desempenho do site</p></li><li data-start="2729" data-end="2763"><p data-start="2731" data-end="2763">Salvar suas preferências de navegação</p></li><li data-start="2764" data-end="2802"><p data-start="2766" data-end="2802">Analisar o tráfego e os comportamentos dos usuários</p></li><li data-start="2803" data-end="2850"><p data-start="2805" data-end="2850">Apoiar campanhas de marketing e remarketing</p></li></ul><p data-start="2852" data-end="2947">Você pode desativar os cookies por meio das configurações do seu navegador, mas alguns recursos podem não funcionar corretamente.</p><p data-start="2949" data-end="3002">Um completo <strong data-start="2956" data-end="2973">Política de cookies</strong> também pode ser adicionado, se necessário.</p><hr data-start="3004" data-end="3007" /><h1 data-start="3009" data-end="3031"><strong data-start="3011" data-end="3031">6. Segurança de dados</strong></h1><p data-start="3032" data-end="3105">Implementamos medidas técnicas e organizacionais razoáveis, incluindo:</p><ul data-start="3107" data-end="3256"><li data-start="3107" data-end="3131"><p data-start="3109" data-end="3131">Criptografia SSL/HTTPS</p></li><li data-start="3132" data-end="3173"><p data-start="3134" data-end="3173">Controle de acesso limitado aos dados armazenados</p></li><li data-start="3174" data-end="3222"><p data-start="3176" data-end="3222">Hospedagem segura e monitoramento regular do sistema</p></li><li data-start="3223" data-end="3256"><p data-start="3225" data-end="3256">Avaliações periódicas de segurança</p></li></ul><p data-start="3258" data-end="3346">Embora nos esforcemos para proteger seus dados, nenhum método de transmissão pela Internet é 100% seguro.</p><hr data-start="3348" data-end="3351" /><h1 data-start="3353" data-end="3376"><strong data-start="3355" data-end="3376">7. Retenção de dados</strong></h1><p data-start="3377" data-end="3442">Retemos os dados pessoais apenas pelo tempo necessário para atender às suas necessidades:</p><ul data-start="3444" data-end="3549"><li data-start="3444" data-end="3465"><p data-start="3446" data-end="3465">Fins comerciais</p></li><li data-start="3466" data-end="3486"><p data-start="3468" data-end="3486">Suporte ao cliente</p></li><li data-start="3487" data-end="3511"><p data-start="3489" data-end="3511">Obrigações contratuais</p></li><li data-start="3512" data-end="3549"><p data-start="3514" data-end="3549">Requisitos legais e regulatórios</p></li></ul><p data-start="3551" data-end="3603">Depois disso, excluímos ou tornamos anônimos os dados de forma segura.</p><hr data-start="3605" data-end="3608" /><h1 data-start="3610" data-end="3630"><strong data-start="3612" data-end="3630">8. Seus direitos</strong></h1><p data-start="3631" data-end="3708">Dependendo da sua jurisdição (GDPR, CCPA, etc.), você pode ter o direito de:</p><ul data-start="3710" data-end="3944"><li data-start="3710" data-end="3746"><p data-start="3712" data-end="3746">Acessar suas informações pessoais</p></li><li data-start="3747" data-end="3778"><p data-start="3749" data-end="3778">Corrigir ou atualizar seus dados</p></li><li data-start="3779" data-end="3825"><p data-start="3781" data-end="3825">Solicitar a exclusão (“direito de ser esquecido”)</p></li><li data-start="3826" data-end="3862"><p data-start="3828" data-end="3862">Restringir ou se opor ao processamento</p></li><li data-start="3863" data-end="3883"><p data-start="3865" data-end="3883">Retirar o consentimento</p></li><li data-start="3884" data-end="3904"><p data-start="3886" data-end="3904">Portabilidade de dados</p></li><li data-start="3905" data-end="3944"><p data-start="3907" data-end="3944">Desativar comunicações de marketing</p></li></ul><p data-start="3946" data-end="3999">Para exercer esses direitos:<br data-start="3971" data-end="3974" />📧 <strong data-start="3977" data-end="3999"><a class="decorated-link cursor-pointer" rel="noopener" data-start="3979" data-end="3997"><span class="__cf_email__" data-cfemail="365b5744425f5876525f5841534f451855595b">[email&#160;protected]</span></a></strong></p><hr data-start="4001" data-end="4004" /><h1 data-start="4006" data-end="4033"><strong data-start="4008" data-end="4033">9. Privacidade das crianças</strong></h1><p data-start="4034" data-end="4181">Nosso site e nossos serviços são <strong data-start="4063" data-end="4114">não se destina a pessoas com menos de 13 anos de idade</strong>.<br data-start="4115" data-end="4118" />Não coletamos intencionalmente informações pessoais de crianças.</p><hr data-start="4183" data-end="4186" /><h1 data-start="4188" data-end="4226"><strong data-start="4190" data-end="4226">10. Transferências internacionais de dados</strong></h1><p data-start="4227" data-end="4372">Como atendemos a clientes globais, suas informações podem ser processadas fora de seu país.<br data-start="4315" data-end="4318" />Asseguramos a aplicação de proteções adequadas, tais como:</p><ul data-start="4374" data-end="4519"><li data-start="4374" data-end="4413"><p data-start="4376" data-end="4413">Cláusulas contratuais padrão (SCCs)</p></li><li data-start="4414" data-end="4459"><p data-start="4416" data-end="4459">Ambientes de hospedagem internacionais seguros</p></li><li data-start="4460" data-end="4519"><p data-start="4462" data-end="4519">Conformidade com as normas internacionais de transferência de dados</p></li></ul><hr data-start="4521" data-end="4524" /><h1 data-start="4526" data-end="4558"><strong data-start="4528" data-end="4558">11. Alterações a esta política</strong></h1><p data-start="4559" data-end="4796">Poderemos atualizar esta Política de Privacidade quando necessário por motivos legais, técnicos ou comerciais.<br data-start="4650" data-end="4653" />As alterações serão publicadas nesta página com a atualização <strong data-start="4706" data-end="4724">Data de vigência</strong>. Para alterações importantes, também podemos notificá-lo por e-mail ou alertas no site.</p><hr data-start="4798" data-end="4801" /><h1 data-start="4803" data-end="4823"><strong data-start="4805" data-end="4823">12. Entre em contato conosco</strong></h1><p data-start="4824" data-end="4908">Se tiver dúvidas sobre esta Política de Privacidade ou sobre seus direitos de dados, entre em contato:</p><p data-start="4910" data-end="4977"><strong data-start="4910" data-end="4920">E-mail:</strong> <a class="decorated-link cursor-pointer" rel="noopener" data-start="4921" data-end="4939"><span class="__cf_email__" data-cfemail="b0ddd1c2c4d9def0d4d9dec7d5c9c39ed3dfdd">[email&#160;protected]</span></a><br data-start="4939" data-end="4942" /><strong data-start="4942" data-end="4954">Site:</strong> <a class="decorated-link" href="" target="_new" rel="noopener" data-start="4955" data-end="4977"></a></p></div>`} />
  </article>

</BaseLayout>
