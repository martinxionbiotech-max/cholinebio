---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Produtos",
};

const products = [
  { title: "Aditivo alimentar fitase termorresistente — Alta atividade (5.000–300.000 U/g)", cat: "Feed Additive", href: "/pt/produto/aditivo-para-racoes-com-fitase-estavel-ao-calor/", img: "/images/uploads/2025/09/Feed-Additive-Application1-1024x1024.jpg" },
  { title: "Betaína Anidra – Aditivo para ração mais vendido, fornecido diretamente pelo fabricante", cat: "Feed Additive", href: "/pt/produto/betaina-anidra/", img: "/images/uploads/2025/08/IMG_0269-1024x1024.jpg" },
  { title: "Aditivo alimentar cloreto de colina 50% – Veículo à base de espiga de milho", cat: "Feed Additive", href: "/pt/produto/cloreto-de-colina-50/", img: "/images/uploads/2025/08/IMG_0275-1024x1024.jpg" },
  { title: "Aditivo alimentar cloreto de colina 60% – Fornecimento pela China com suporte de espiga de milho", cat: "Feed Additive", href: "/pt/produto/cloreto-de-colina-60/", img: "/images/uploads/2025/08/IMG_0274-1024x1024.jpg" },
  { title: "Cloreto de colina 75% – Aditivo alimentar líquido de alta pureza, líder de vendas", cat: "Feed Additive", href: "/pt/produto/cloreto-de-colina-75-liquido/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "Cloridrato de betaína – Fornecimento direto do fabricante de aditivos para rações", cat: "Feed Additive", href: "/pt/produto/cloridrato-de-betaina-de-grau-alimenticio/", img: "/images/uploads/2025/08/IMG_0272-1024x1024.jpg" },
  { title: "(DCP) Fosfato dicálcico 18% em pó – Aditivo para ração", cat: "Feed Additive", href: "/pt/produto/dcp-18-po/", img: "/images/uploads/2025/09/DCP18-powder-2-1024x1024.jpg" },
  { title: "(DCP) Fosfato dicálcico 17% em pó – Aditivo para ração", cat: "Feed Additive", href: "/pt/produto/dcp-fosfato-dicalcico-17/", img: "/images/uploads/2025/09/DCP17-4-1024x1024.jpg" },
  { title: "Enzima fitase — Aditivo alimentar em pó mais vendido", cat: "Feed Additive", href: "/pt/produto/enzima-fitase-em-po-de-grau-alimenticio/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-1024x1024.jpg" },
  { title: "Sulfato de L-lisina 70% (grau alimentício) — Aditivo de aminoácidos para nutrição animal", cat: "Feed Additive", href: "/pt/produto/l-lysine-sulphate-70-feed-grade/", img: "/images/uploads/2025/09/1-1024x1024.jpg" },
  { title: "Aditivo alimentar em pó de vitamina B12 (mecobalamina)", cat: "Feed Additive", href: "/pt/produto/vitamina-b12-em-po-para-racoes-mecobalamina/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" },
  { title: "Vitamina B2 em pó (riboflavina) – Aditivo alimentar mais vendido", cat: "Feed Additive", href: "/pt/produto/vitamina-b2-em-po-riboflavina-aditivo-para-racoes/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-1024x1024.jpg" },
  { title: "Vitamina C (Ácido Ascórbico) – Aditivo alimentar mais vendido – 25 kg/caixa", cat: "Feed Additive", href: "/pt/produto/vitamina-c-acido-ascorbico-grau-alimenticio-99/", img: "/images/uploads/2025/09/IMG_0271-1024x1024.jpg" }
];
---

<BaseLayout title={page.title} lang="pt-BR" description="Feed-grade additives for animal nutrition — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes." canonical="/pt/produto/">
  <div class="container section">
    <span class="kicker">Produtos</span>
    <h1 class="sec-title">Produtos</h1>
    <p class="sec-sub">Feed-grade additives for animal nutrition.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
