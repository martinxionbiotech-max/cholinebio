---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Blog",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "Preço da cloreto de colina na China em 2025 por tonelada: tendências e previsões de mercado", href: "/pt/2025-preco-do-cloreto-de-colina-da-china-por-tonelada/" },
  { title: "Cloreto de colina na ração para cães: funções, benefícios e considerações", href: "/pt/cloreto-de-colina-em-racao-para-caes/" },
  { title: "Cloreto de colina na ração para gatos: funções essenciais, benefícios e comparação com a nutrição canina", href: "/pt/cloreto-de-colina-em-racao-para-gatos/" },
  { title: "Cloreto de colina na ração para aves – O que você precisa saber!", href: "/pt/cloreto-de-colina-em-racoes-para-aves/" },
  { title: "Alimento com cloreto de colina: 5 pontos essenciais que você precisa saber antes de comprar", href: "/pt/cloreto-de-colina-feed-5-chaves-que-voce-deve-saber/" },
  { title: "Colina e inositol: em aditivos para rações animais", href: "/pt/colina-e-inositol/" },
  { title: "O que é o fosfato dicálcico? As informações mais completas que você precisa saber", href: "/pt/o-que-e-fosfato-dicalcico/" },
  { title: "O que é o cloreto de colina? Como é fabricado na China?", href: "/pt/o-que-e-o-guia-de-fabricacao-de-cloreto-de-colina-na-china/" },
  { title: "O que são aditivos fitogênicos para rações? Comparação do cloreto de colina", href: "/pt/o-que-sao-aditivos-fitogenicos-para-racoes/" }
];
---

<BaseLayout title={page.title} hreflang={hreflang} lang="pt-PT" description="Feed additive industry insights" canonical="/pt/blog/">
  <div class="container section">
    <span class="kicker">Blog</span>
    <h1 class="sec-title">Blog</h1>
    <p class="sec-sub">Practical guides on choline chloride, dicalcium phosphate, vitamins and amino acids.</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>Read article →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
