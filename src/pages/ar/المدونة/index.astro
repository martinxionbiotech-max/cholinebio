---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "المدونة",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "سعر كلوريد الكولين في الصين لعام 2025 للطن الواحد: اتجاهات السوق والتوقعات", href: "/ar/2025-سعر-كلوريد-الكولين-كلوريد-الصين-2025-للط/" },
  { title: "الكولين والإينوزيتول: في إضافات أعلاف الحيوانات", href: "/ar/الكولين-والإينوزيتول/" },
  { title: "علف كلوريد الكولين: 5 أمور أساسية يجب معرفتها قبل الشراء", href: "/ar/تغذية-كلوريد-الكولين-5-مفاتيح-يجب-أن-تعر/" },
  { title: "كلوريد الكولين في طعام القطط: الوظائف الأساسية، والفوائد، والمقارنة مع تغذية الكلاب", href: "/ar/كلوريد-الكولين-في-طعام-القطط/" },
  { title: "كلوريد الكولين في أغذية الكلاب: الوظائف والفوائد والاعتبارات", href: "/ar/كلوريد-الكولين-في-طعام-الكلاب/" },
  { title: "كلوريد الكولين في علف الدواجن – ما تحتاج إلى معرفته!", href: "/ar/كلوريد-الكولين-في-علف-الدواجن/" },
  { title: "ما هو كلوريد الكولين؟ كيف يتم تصنيعه في الصين؟", href: "/ar/ما-هو-دليل-تصنيع-كلوريد-الكولين-في-الصي/" },
  { title: "ما هو فوسفات ثنائي الكالسيوم؟ المعلومات الأكثر شمولاً التي تحتاجها", href: "/ar/ما-هو-فوسفات-الديكالسيوم/" },
  { title: "ما هي المضافات العلفية النباتية المنشأ؟ مقارنة كلوريد الكولين", href: "/ar/ما-هي-إضافات-الأعلاف-النباتية؟/" }
];
---

<BaseLayout title={page.title} hreflang={hreflang} lang="ar" description="Feed additive industry insights" canonical="/ar/المدونة/">
  <div class="container section">
    <span class="kicker">المدونة</span>
    <h1 class="sec-title">المدونة</h1>
    <p class="sec-sub">Practical guides on choline chloride, dicalcium phosphate, vitamins and amino acids.</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>Read article →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
