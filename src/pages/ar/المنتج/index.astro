---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "المنتجات",
};

const products = [
  { title: "البيتين اللامائي – المضافات العلفية الأكثر مبيعًا، توريد مباشر من المصنع", cat: "Feed Additive", href: "/ar/المنتج/البيتين-اللامائي/", img: "/images/uploads/2025/08/IMG_0269-1024x1024.jpg" },
  { title: "(DCP) مسحوق فوسفات ثنائي الكالسيوم 17% – مضافات الأعلاف", cat: "Feed Additive", href: "/ar/المنتج/دي-سي-بي-فوسفات-الديكالسيوم-17/", img: "/images/uploads/2025/09/DCP17-4-1024x1024.jpg" },
  { title: "فيتامين C (حمض الأسكوربيك) – المضافات العلفية الأكثر مبيعًا – 25 كجم/كرتونة", cat: "Feed Additive", href: "/ar/المنتج/فيتامين-ج-حمض-الأسكوربيك-حمض-الأسكورب/", img: "/images/uploads/2025/09/IMG_0271-1024x1024.jpg" },
  { title: "مضافات الأعلاف «كلوريد الكولين 50%» – حامل من قشور الذرة – شركة «دينويز بيوتك» – تصدير مضافات الأعلاف وتوزيعها عالميًا", cat: "Feed Additive", href: "/ar/المنتج/كلوريد-الكولين-50/", img: "/images/uploads/2025/08/IMG_0275-1024x1024.jpg" },
  { title: "مضافات الأعلاف «كلوريد الكولين 60%» – مورد صيني للناقل المصنوع من قشور الذرة – شركة «دينويز بيوتك» – تصدير مضافات الأعلاف وتوزيعها عالميًا", cat: "Feed Additive", href: "/ar/المنتج/كلوريد-الكولين-60/", img: "/images/uploads/2025/08/IMG_0274-1024x1024.jpg" },
  { title: "كلوريد الكولين 75% – مادة مضافة للأعلاف سائلة عالية النقاء والأكثر مبيعًا", cat: "Feed Additive", href: "/ar/المنتج/كلوريد-الكولين-75-سائل/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "كبريتات L-ليسين 70% (درجة الأعلاف) — مادة مضافة من الأحماض الأمينية لتغذية الحيوانات", cat: "Feed Additive", href: "/ar/المنتج/ل-ليسين-سلفات-ليسين-70-درجة-العلف/", img: "/images/uploads/2025/09/1-1024x1024.jpg" },
  { title: "(DCP) مسحوق فوسفات ثنائي الكالسيوم 18% – مضافات الأعلاف", cat: "Feed Additive", href: "/ar/المنتج/مسحوق-dcp-18/", img: "/images/uploads/2025/09/DCP18-powder-2-1024x1024.jpg" },
  { title: "إنزيم الفيتاز — مسحوق إضافات الأعلاف الأكثر مبيعًا", cat: "Feed Additive", href: "/ar/المنتج/مسحوق-إنزيم-إنزيم-الفيتاز-في-الأعلاف/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-1024x1024.jpg" },
  { title: "مسحوق فيتامين ب2 (الريبوفلافين) – المضافات العلفية الأكثر مبيعًا", cat: "Feed Additive", href: "/ar/المنتج/مسحوق-فيتامين-b2-مسحوق-الريبوفلافين-الم/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-1024x1024.jpg" },
  { title: "مسحوق فيتامين ب12 (ميكوبالامين) – مضافات علفية", cat: "Feed Additive", href: "/ar/المنتج/مسحوق-فيتامين-ب-12-ميكوبالامين-ميكوبالا/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" },
  { title: "مضافات علفية من نوع «فيتاز» المقاومة للحرارة — ذات فعالية عالية (5,000–300,000 وحدة/غرام)", cat: "Feed Additive", href: "/ar/المنتج/مضافات-أعلاف-الفيتاز-المستقرة-حراريا/", img: "/images/uploads/2025/09/Feed-Additive-Application1-1024x1024.jpg" },
  { title: "هيدروكلوريد البيتين – توريد مباشر من المصنع لمضافات الأعلاف", cat: "Feed Additive", href: "/ar/المنتج/هيدروكلوريد-البيتين-هيدروكلوريد-الأ/", img: "/images/uploads/2025/08/IMG_0272-1024x1024.jpg" }
];
---

<BaseLayout title={page.title} lang="ar" description="Feed-grade additives for animal nutrition — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes." canonical="/ar/المنتج/">
  <div class="container section">
    <span class="kicker">المنتجات</span>
    <h1 class="sec-title">المنتجات</h1>
    <p class="sec-sub">Feed-grade additives for animal nutrition.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
