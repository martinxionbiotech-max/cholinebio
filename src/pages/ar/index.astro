---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "دينويز بيوتك – تصدير إضافات الأعلاف والتوزيع العالمي – دينويز بيوتك هي وحدة مخصصة للمبيعات والتصدير على الصعيد العالمي لمجموعة من الشركات المصنعة المؤهلة لمضافات الأعلاف في الصين، وهي متخصصة في كلوريد الكولين، والبيتين، وفوسفات ثنائي الكالسيوم، والأحماض الأمينية، والفيتامينات المستخدمة في أعلاف الدواجن، والخنازير، والحيوانات المجترة، وتربية الأحياء المائية.",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/'/>";
---

<BaseLayout title={page.title} hreflang={hreflang} lang="ar" description="Export & International Sales Partner for China Feed Additives" canonical="/ar/">
  <section class="hero">
    <div class="container">
      <h1>دينويز بيوتك – تصدير إضافات الأعلاف والتوزيع العالمي</h1>
      <p class="lead">Dinweys Biotech is the dedicated global sales and export division for qualified feed additive manufacturers — supplying choline chloride, betaine, dicalcium phosphate, amino acids, and vitamins worldwide.</p>
      <div class="hero-actions">
        <a class="btn white" href="/ar/">Explore Products</a>
        <a class="btn ghost-hero" href="/ar/">Get a Quote</a>
      </div>
      <div class="hero-stats">
        <div><b>20+</b><span>Countries</span></div>
        <div><b>100+</b><span>Clients</span></div>
        <div><b>ISO·HACCP·FAMI-QS</b><span>Certified</span></div>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <span class="kicker">Product Range</span>
      <h2 class="sec-title">Our Feed Additive Categories</h2>
      <p class="sec-sub">Sourced direct from certified Chinese manufacturers, with full documentation and export support.</p>
      <div class="card-grid">
        <div class="card">
          <div class="body">
            <h3><a href="/product/">علف كلوريد الكولين</a></h3>
            <p>60% corn cob, 60% silica, 50% corn cob, and 75% liquid — a core Vitamin B4 supplement for poultry, swine, and aquaculture.</p>
            <a class="link" href="/product/">Learn more →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3><a href="/product/">مسحوق علف الفيتامينات</a></h3>
            <p>Riboflavin (B2), Ascorbic Acid (C), and more — feed-grade vitamins for balanced animal nutrition.</p>
            <a class="link" href="/product/">Learn more →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3><a href="/product/">المعادن للأعلاف</a></h3>
            <p>Dicalcium Phosphate (DCP 17% & 18%) and mineral additives for skeletal development and production performance.</p>
            <a class="link" href="/product/">Learn more →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3><a href="/product/">الأحماض الأمينية الخلاصة</a></h3>
            <p>L-Lysine Sulphate 70%, DL-Methionine, L-Threonine — essential amino acids for optimized feed formulation.</p>
            <a class="link" href="/product/">Learn more →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3><a href="/product/">تحضير إنزيمات الأعلاف</a></h3>
            <p>Heat-stable phytase and granular phytase to improve phosphorus availability and feed efficiency.</p>
            <a class="link" href="/product/">Learn more →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <span class="kicker">Quality Assurance</span>
      <h2 class="sec-title">Certified Manufacturing Partners</h2>
      <p class="sec-sub">Our partner facilities hold internationally recognized quality and safety certifications.</p>
      <div class="cert-grid">
        <div class="cert-card">
          <div class="cert-img"><img src="/images/uploads/2025/12/ISO.png" alt="مصنع إضافات الأعلاف ISO 9001" loading="lazy" /></div>
          <h3>ISO 9001</h3>
          <p>Quality management system</p>
        </div>
        <div class="cert-card">
          <div class="cert-img"><img src="/images/uploads/2025/12/HACCP-1024x1024.png" alt="مصنع إضافات الأعلاف HACCP" loading="lazy" /></div>
          <h3>HACCP</h3>
          <p>Hazard analysis & critical control points</p>
        </div>
        <div class="cert-card">
          <div class="cert-img"><img src="/images/uploads/2025/12/HSL.jpg" alt="مصنع إضافات الأعلاف FAMI-QS" loading="lazy" /></div>
          <h3>FAMI-QS</h3>
          <p>Feed additive quality standard (Europe)</p>
        </div>
      </div>
    </section>

    <section class="section">
      <span class="kicker">Why Choose Us</span>
      <h2 class="sec-title">Your Trusted Feed Additive Sourcing Partner</h2>
      <div class="card-grid">
        <div class="card">
          <div class="body">
            <h3>Export & Communication Advantage</h3>
            <p>Designated export and sales partner for qualified manufacturers, with consistent international communication.</p>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3>Product & Market Support</h3>
            <p>Assistance with product specifications, regulatory information, and logistics coordination.</p>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3>Reliable Global Delivery</h3>
            <p>Timely delivery, clear export procedures, and dependable service.</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="container">
    <section class="cta-band">
      <h2>Ready to Source Quality Feed Additives?</h2>
      <p>Get competitive pricing, COA documentation, and reliable export logistics.</p>
      <a class="btn" href="/ar/">Contact Our Sales Team</a>
    </section>
  </div>
</BaseLayout>
