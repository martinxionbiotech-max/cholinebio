---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Blog",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "Prix de la chlorure de choline en Chine en 2025 (par tonne) : tendances du marché et prévisions", href: "/fr/2025-chlorure-de-choline-de-chine-prix-par-tonne/" },
  { title: "Aliments à base de chlorure de choline : 5 points essentiels à connaître avant d'acheter", href: "/fr/chlorure-de-choline-alimentation-5-cles-a-connaitre/" },
  { title: "Le chlorure de choline dans les aliments pour chats : fonctions essentielles, bienfaits et comparaison avec l'alimentation canine", href: "/fr/chlorure-de-choline-dans-les-aliments-pour-chats/" },
  { title: "Le chlorure de choline dans les aliments pour chiens : fonctions, bienfaits et points à prendre en compte", href: "/fr/chlorure-de-choline-dans-les-aliments-pour-chiens/" },
  { title: "Le chlorure de choline dans l'alimentation des volailles – Ce qu'il faut savoir !", href: "/fr/chlorure-de-choline-dans-les-aliments-pour-volailles/" },
  { title: "Qu'est-ce que le chlorure de choline ? Comment est-il fabriqué en Chine ?", href: "/fr/guide-de-fabrication-du-chlorure-de-choline-en-chine/" },
  { title: "Choline et inositol : additifs alimentaires pour animaux", href: "/fr/la-choline-et-linositol/" },
  { title: "Qu'est-ce que le phosphate dicalcique ? Toutes les informations indispensables", href: "/fr/quest-ce-que-le-phosphate-dicalcique/" },
  { title: "Que sont les additifs alimentaires d'origine végétale ? Comparaison du chlorure de choline", href: "/fr/quest-ce-quun-additif-phytogene-pour-lalimentation-animale/" }
];
---

<BaseLayout title={page.title} hreflang={hreflang} lang="fr-FR" description="Feed additive industry insights" canonical="/fr/blog/">
  <div class="container section">
    <span class="kicker">Blog</span>
    <h1 class="sec-title">Blog</h1>
    <p class="sec-sub">Practical guides on choline chloride, dicalcium phosphate, vitamins and amino acids.</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>Read article →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
