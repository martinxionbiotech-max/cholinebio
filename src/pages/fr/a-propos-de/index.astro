const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/about/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/about/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%ad%d9%88%d9%84/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/a-propos-de/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/hakkinda/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/acerca-de/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/uber/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%85%b3%e4%ba%8e/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/sobre/'/>";
---
<BaseLayout title={page.title} ogType="website" canonical="/fr/a-propos-de/" lang="fr" hreflang={hreflang}>
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<div class="entry-content single-content"><div class="kb-row-layout-wrap kb-row-layout-id56_3f32c9-c8 alignfull kt-row-has-bg wp-block-kadence-rowlayout"><div class="kt-row-layout-overlay kt-row-overlay-normal"></div><div class="kt-row-column-wrap kt-has-1-columns kt-row-layout-equal kt-tab-layout-inherit kt-mobile-layout-row kt-row-valign-bottom kb-theme-content-width"><div class="wp-block-kadence-column kadence-column56_322566-fd inner-column-1"><div class="kt-inside-inner-col"><div class="wp-block-kadence-spacer aligncenter kt-block-spacer-56_e3f04f-95"><div class="kt-block-spacer kt-block-spacer-halign-center"><hr class="kt-divider"/></div></div><h1 class="kt-adv-heading56_69515d-c5 wp-block-kadence-advancedheading has-theme-palette-9-color has-text-color" data-kb-block="kb-adv-heading56_69515d-c5">A propos de Dinweys Biotech : Votre centre mondial intégré de vente et de service</h1><p class="kt-adv-heading56_1584a9-32 wp-block-kadence-advancedheading has-theme-palette-8-color has-text-color" data-kb-block="kb-adv-heading56_1584a9-32">Au <strong>Dinweys Biotech</strong>, Nous simplifions l'approvisionnement mondial en solutions de nutrition animale de haute qualité. En intégrant <strong>approvisionnement direct de l'usine</strong> avec <strong>services experts en commerce international</strong>, Nous fournissons une chaîne d'approvisionnement stable, rentable et transparente aux exploitations agricoles et aux entreprises. <a href="/product/" data-internallinksmanager029f6b8e52c="4" title="Additifs pour l&#039;alimentation animale">alimentation</a> dans plus de 20 pays.</p></div></div></div></div><div class="kb-row-layout-wrap kb-row-layout-id56_2c6407-b0 alignnone wp-block-kadence-rowlayout"><div class="kt-row-column-wrap kt-has-1-columns kt-row-layout-equal kt-tab-layout-inherit kt-mobile-layout-row kt-row-valign-top"><div class="wp-block-kadence-column kadence-column56_fea4f4-57"><div class="kt-inside-inner-col"><div style="height:10px" aria-hidden="true" class="wp-block-spacer"></div></div></div></div></div><div class="kb-row-layout-wrap kb-row-layout-id56_9491f7-df alignnone has-theme-palette7-background-color kt-row-has-bg wp-block-kadence-rowlayout"><div class="kt-row-column-wrap kt-has-1-columns kt-row-layout-equal kt-tab-layout-inherit kt-mobile-layout-row kt-row-valign-top kb-theme-content-width"><div class="wp-block-kadence-column kadence-column56_44f460-c8"><div class="kt-inside-inner-col"><h2 class="wp-block-heading has-text-align-center">Qui sommes-nous ? Le pont stratégique vers l'industrie chinoise des additifs pour l'alimentation animale</h2><p class="wp-block-paragraph"><em>Partenaire mondial de confiance en matière de nutrition animale et d'additifs alimentaires</em></p><blockquote class="wp-block-quote is-layout-flow wp-block-quote-is-layout-flow"><p class="wp-block-paragraph"><strong>Dinweys Biotech</strong> fonctionne comme le <strong>Division spécialisée dans les ventes et l'exportation au niveau mondial</strong> pour un groupe de fabricants qualifiés d'additifs pour l'alimentation animale en Chine.</p><p class="wp-block-paragraph">Contrairement aux sociétés commerciales traditionnelles, nous sommes <strong>profondément intégré avec les bases de production de nos partenaires</strong>. Nous leur servons de visage international, en gérant tout, de la communication technique à la conformité réglementaire, en passant par une logistique mondiale complexe. Ce modèle permet à nos usines partenaires de se concentrer sur l'excellence de la production, tandis que nous veillons à ce que nos clients internationaux reçoivent <strong>la tarification directe à l'usine</strong> jumelé avec <strong>un service de classe mondiale</strong>.</p><h3 class="wp-block-heading"><strong>Notre expertise de base</strong></h3><ul class="wp-block-list"><li><strong>Partenariat stratégique de fabrication :</strong> Nous entretenons une coopération exclusive/profonde avec des installations certifiées ISO et FAMI-QS spécialisées dans <strong><a href="/fr/produit/chlorure-de-choline-60/" data-internallinksmanager029f6b8e52c="1" title="Chlorure de choline 60% Additif pour l&#039;alimentation animale - Corn Cob Carrier China Manufacturer Supply">Chlorure de choline</a>, <a href="/product_category/vitamins/" data-internallinksmanager029f6b8e52c="2" title="vitamines">Vitamines</a>, Acides aminés et additifs minéraux pour l'alimentation animale</strong>.</li><li><strong>Supervision technique :</strong> Notre équipe ne se contente pas de “vendre”, elle assure l'alignement technique entre les formulations du client et les normes de production de l'usine.</li><li><strong>Conformité mondiale :</strong> Nous comblons le fossé entre la fabrication chinoise et les exigences réglementaires internationales, garantissant ainsi un dédouanement sans heurts et l'acceptation des produits.</li></ul></blockquote><h2 class="wp-block-heading">Assistance technique et services à valeur ajoutée</h2><blockquote class="wp-block-quote is-layout-flow wp-block-quote-is-layout-flow"><p class="wp-block-paragraph">Nous ne nous contentons pas de “déplacer des produits”. Nous proposons une gamme complète de services conçus pour optimiser votre expérience en matière d'approvisionnement :</p><ul class="wp-block-list"><li><strong>Logistique de bout en bout :</strong> Planification stratégique du fret maritime, aérien et terrestre afin de minimiser les délais et de réduire les coûts totaux au débarquement.</li><li><strong>Consultation technique :</strong> Conseils d'experts sur les qualités de produits, les taux d'inclusion et l'optimisation de l'application pour différentes espèces animales.</li><li><strong>Soutien en matière de réglementation et de documentation :</strong> Assistance pour les permis d'importation, les certificats sanitaires et la documentation spécifique au pays afin de garantir la conformité à la norme 100%.</li><li><strong>Assurance et surveillance de la qualité :</strong> Nous nous coordonnons avec des laboratoires partenaires pour fournir des COA (certificats d'analyse) spécifiques aux lots et effectuer des inspections avant expédition.</li></ul></blockquote></div></div></div></div><div class="kb-row-layout-wrap kb-row-layout-id56_597056-6a alignfull has-theme-palette8-background-color kt-row-has-bg wp-block-kadence-rowlayout"><div class="kt-row-layout-overlay kt-row-overlay-gradient"></div><div class="kt-row-column-wrap kt-has-2-columns kt-row-layout-right-golden kt-tab-layout-left-golden kt-mobile-layout-row kt-row-valign-top kb-theme-content-width"><div class="wp-block-kadence-column kadence-column56_d02322-fe"><div class="kt-inside-inner-col"><h2 class="kt-adv-heading56_8c61d9-91 wp-block-kadence-advancedheading" data-kb-block="kb-adv-heading56_8c61d9-91">Force technique</h2><p class="wp-block-paragraph">Notre force réside dans la <strong>la synergie entre la production et le service</strong>.</p><ol start="1" class="wp-block-list"><li><strong>Supervision directe :</strong> Nous travaillons sur place avec nos usines partenaires pour contrôler les calendriers de production et la constance de la qualité.</li><li><strong>Équipe d'experts :</strong> Notre personnel se compose d'ingénieurs alimentaires et de spécialistes de l'exportation qui comprennent les nuances de l'alimentation animale et du commerce international.</li><li><strong>Un bilan mondial :</strong> Forts d'une expérience de plus de 100 clients dans plus de 20 pays, nous comprenons les besoins spécifiques des différentes régions.</li></ol></div></div><div class="wp-block-kadence-column kadence-column56_8ec7ce-80"><div class="kt-inside-inner-col"></div></div></div></div><div class="kb-row-layout-wrap kb-row-layout-id56_78e2f9-87 alignnone wp-block-kadence-rowlayout"><div class="kt-row-column-wrap kt-has-1-columns kt-row-layout-equal kt-tab-layout-inherit kt-mobile-layout-row kt-row-valign-top kb-theme-content-width"><div class="wp-block-kadence-column kadence-column56_d3b7a8-bb"><div class="kt-inside-inner-col"><h2 class="kt-adv-heading56_14d7a2-0a wp-block-kadence-advancedheading has-theme-palette-7-background-color has-background" data-kb-block="kb-adv-heading56_14d7a2-0a">Le <strong>Vérification</strong> de <strong>Notre entreprise </strong></h2><p class="wp-block-paragraph">À une époque où la confiance est primordiale, <strong>Dinweys Biotech</strong> (Zhangjiakou Dingwei Biotechnology Co., Ltd.) privilégie la transparence absolue. Nous invitons nos partenaires à vérifier notre statut juridique et opérationnel :</p><figure class="wp-block-table"><table class="has-fixed-layout"><thead><tr><td><strong>Détail de la vérification</strong></td><td><strong>Informations</strong></td></tr></thead><tbody><tr><td><strong>Nom officiel de l'entreprise</strong></td><td>Zhangjiakou Dingwei Biotechnology Co, Ltd.</td></tr><tr><td><strong>Licence d'exploitation (USCI)</strong></td><td>91130702MADY9DX57U</td></tr><tr><td><strong>Numéro D-U-N-S</strong></td><td><strong>456653698</strong></td></tr><tr><td><strong>Numéro d'enregistrement douanier.</strong></td><td>1307961A3J</td></tr><tr><td><strong>Siège</strong></td><td>Ville de Zhangjiakou, province de Hebei, Chine</td></tr></tbody></table></figure><p class="wp-block-paragraph">Ressources de vérification :</p><p class="wp-block-paragraph">Vous pouvez vérifier nos références auprès du National Enterprise Credit Information Publicity System (Chine) ou de D&amp;B (Dun &amp; Bradstreet). D'autres documents (licence d'exploitation, certificats fiscaux ou rapports d'audit d'usine) sont disponibles sur demande.</p></div></div></div></div><p class="wp-block-paragraph"></p></div>`} />
  </article>
</BaseLayout>
