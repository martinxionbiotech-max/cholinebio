const page = {
  title: "Sulfate de L-lysine 70% (qualité alimentaire) — Additif à base d'acides aminés pour la nutrition animale",
  description: "Rentabilité - coût par gramme de lysine utilisable inférieur à celui de la L-Lysine HCl, bien que le dosage soit plus élevé.",
