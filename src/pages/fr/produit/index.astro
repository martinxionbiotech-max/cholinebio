---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Produits",
};

const products = [
  { title: "Bétaïne anhydre – L’additif alimentaire le plus vendu, fourni directement par le fabricant", cat: "Feed Additive", href: "/fr/produit/betaine-anhydre/", img: "/images/uploads/2025/08/IMG_0269-768x768.jpg" },
  { title: "Chlorhydrate de bétaïne – Fourniture directe par le fabricant d'additifs alimentaires", cat: "Feed Additive", href: "/fr/produit/chlorhydrate-de-betaine-de-qualite-alimentaire/", img: "/images/uploads/2025/08/IMG_0272-768x768.jpg" },
  { title: "Additif alimentaire « Chlorure de choline 50% » – Support : épis de maïs", cat: "Feed Additive", href: "/fr/produit/chlorure-de-choline-50/", img: "/images/uploads/2025/08/IMG_0275-768x768.jpg" },
  { title: "Additif alimentaire « Chlorure de choline 60% » – Fournisseur chinois d'un support à base d'épis de maïs", cat: "Feed Additive", href: "/fr/produit/chlorure-de-choline-60/", img: "/images/uploads/2025/08/IMG_0274-768x768.jpg" },
  { title: "Chlorure de choline 75% – Additif alimentaire liquide de haute pureté, best-seller", cat: "Feed Additive", href: "/fr/produit/chlorure-de-choline-75-liquide/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "(DCP) Phosphate dicalcique 18% en poudre – Additif alimentaire", cat: "Feed Additive", href: "/fr/produit/dcp-18-poudre/", img: "/images/uploads/2025/09/DCP18-powder-2-768x768.jpg" },
  { title: "Enzyme phytase — Additif alimentaire en poudre le plus vendu", cat: "Feed Additive", href: "/fr/produit/enzyme-phytase-poudre-de-qualite-alimentaire/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-768x768.jpg" },
  { title: "(DCP) Phosphate dicalcique 17% en poudre – Additif alimentaire", cat: "Feed Additive", href: "/fr/produit/phosphate-dicalcique-17/", img: "/images/uploads/2025/09/DCP17-4-768x768.jpg" },
  { title: "Additif alimentaire à base de phytase thermostable — Haute activité (5 000 à 300 000 U/g)", cat: "Feed Additive", href: "/fr/produit/phytase-thermostable-additif-pour-lalimentation-animale/", img: "/images/uploads/2025/09/Feed-Additive-Application1-768x768.jpg" },
  { title: "Sulfate de L-lysine 70% (qualité alimentaire) — Additif à base d'acides aminés pour la nutrition animale", cat: "Feed Additive", href: "/fr/produit/sulfate-de-lysine-70-qualite-fourragere/", img: "/images/uploads/2025/09/1-768x768.jpg" },
  { title: "Additif alimentaire à base de vitamine B12 en poudre (mécobalamine)", cat: "Feed Additive", href: "/fr/produit/vitamine-b12-en-poudre-de-qualite-alimentaire-mecobalamine/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" },
  { title: "Vitamine B2 en poudre (riboflavine) – L'additif alimentaire le plus vendu", cat: "Feed Additive", href: "/fr/produit/vitamine-b2-en-poudre-riboflavine-additif-pour-lalimentation-animale/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-768x768.jpg" },
  { title: "Vitamine C (acide ascorbique) – Additif alimentaire le plus vendu – 25 kg/carton", cat: "Feed Additive", href: "/fr/produit/vitamine-c-acide-ascorbique-qualite-alimentaire-99/", img: "/images/uploads/2025/09/IMG_0271-768x768.jpg" }
];
---

<BaseLayout title={page.title} lang="fr" description="Feed-grade additives for animal nutrition — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes." canonical="/fr/produit/">
  <div class="container section">
    <span class="kicker">Produits</span>
    <h1 class="sec-title">Produits</h1>
    <p class="sec-sub">Feed-grade additives for animal nutrition.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
