    <div class="entry-content" set:html={`<main id="primary" class="site-main container" style="max-width:1200px; margin:0 auto; padding:2rem 1rem;"><article id="post-615" class="cpt-single-product post-615 product type-product status-publish format-standard has-post-thumbnail hentry product_category-enzyme-preparation" itemscope itemtype="https://schema.org/Product"><section class="product-hero" style="display:flex;flex-wrap:wrap;gap:2rem;align-items:flex-start;margin-bottom:2rem;"><div class="product-image" style="flex:1 1 400px;max-width:600px;">
