---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Blog",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "What is Choline Chloride? How is the China Made？", href: "/what-is-choline-chloride-china-manufacturing-guide/" },
  { title: "Feed Additives Classification", href: "/feed-additives-classification/" },
  { title: "Choline Chloride Feed: 5 Key Things You Must Know Before Buying", href: "/choline-chloride-feed-5-keys-you-must-know/" },
  { title: "Choline and Inositol: in Animal Feed Additives", href: "/choline-and-inositol/" },
  { title: "Choline Chloride in Poultry Feed – Things You Need to Know!", href: "/choline-chloride-in-poultry-feed/" },
  { title: "Choline Chloride in Cat Food: Essential Functions, Benefits, and Comparison with Dog Nutrition", href: "/choline-chloride-in-cat-food/" },
  { title: "Choline Chloride in Dog Food: Functions, Benefits, and Considerations", href: "/choline-chloride-in-dog-food/" },
  { title: "What is Dicalcium Phosphate? Most Complete Information You Must Need", href: "/what-is-dicalcium-phosphate/" },
  { title: "What Are Phytogenic Feed Additives? Choline Chloride Comparison", href: "/what-are-phytogenic-feed-additives/" },
  { title: "2025 China Choline Chloride Price per Ton: Market Trends & Forecast", href: "/2025-china-choline-chloride-price-per-ton/" },
];
---

<BaseLayout title={page.title} hreflang={hreflang} description="Feed additive industry insights — choline chloride, dicalcium phosphate, vitamins, amino acids, and practical sourcing guidance for animal nutrition." canonical="/blog/">
  <div class="container section">
    <span class="kicker">Blog</span>
    <h1 class="sec-title">Feed Additive Industry Insights</h1>
    <p class="sec-sub">Practical guides and technical articles on choline chloride, dicalcium phosphate, vitamins, and amino acids for animal nutrition.</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>Read article →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
