---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "产品",
};

const products = [
  { title: "(DCP) 磷酸二钙 18% 粉末 – 饲料添加剂", cat: "Feed Additive", href: "/zh/产品/dcp-18-粉末/", img: "/images/uploads/2025/09/DCP18-powder-2-768x768.jpg" },
  { title: "无水甜菜碱——畅销饲料添加剂，直供制造商—", cat: "Feed Additive", href: "/zh/产品/无水甜菜碱/", img: "/images/uploads/2025/08/IMG_0269-768x768.jpg" },
  { title: "植酸酶——畅销饲料添加剂粉—", cat: "Feed Additive", href: "/zh/产品/植酸酶饲料级粉末/", img: "/images/uploads/2025/09/imgi_298_powder-app_baking-soda1-768x768.jpg" },
  { title: "氯化胆碱 50% 饲料添加剂——玉米芯载体—", cat: "Feed Additive", href: "/zh/产品/氯化胆碱-50/", img: "/images/uploads/2025/08/IMG_0275-768x768.jpg" },
  { title: "氯化胆碱 60% 饲料添加剂——玉米芯载体 中国制造商供应—", cat: "Feed Additive", href: "/zh/产品/氯化胆碱-60/", img: "/images/uploads/2025/08/IMG_0274-768x768.jpg" },
  { title: "氯化胆碱 75% – 高纯度液体畅销饲料添加剂", cat: "Feed Additive", href: "/zh/产品/氯化胆碱-75-液体/", img: "/images/uploads/2025/09/choline-chloride-75-liquid.jpg" },
  { title: "耐热植酸酶饲料添加剂——高活性（5,000–300,000 U/g）—", cat: "Feed Additive", href: "/zh/产品/热稳定植酸酶饲料添加剂/", img: "/images/uploads/2025/09/Feed-Additive-Application1-768x768.jpg" },
  { title: "(DCP) 磷酸二钙 17% 粉末 – 饲料添加剂", cat: "Feed Additive", href: "/zh/产品/磷酸二钙-17/", img: "/images/uploads/2025/09/DCP17-4-768x768.jpg" },
  { title: "维生素B2粉（核黄素）——畅销饲料添加剂—", cat: "Feed Additive", href: "/zh/产品/维生素-b2-粉核黄素饲料添加剂/", img: "/images/uploads/2025/08/Vitamin-B2-Powder-Riboflavin-2013-Feed-Additive-China-Manufacturer-Supply-2-768x768.jpg" },
  { title: "维生素C（抗坏血酸）畅销饲料添加剂——25公斤/箱—", cat: "Feed Additive", href: "/zh/产品/维生素-c-抗坏血酸饲料级-99/", img: "/images/uploads/2025/09/IMG_0271-768x768.jpg" },
  { title: "L-赖氨酸硫酸盐 70%（饲料级）——动物营养用氨基酸添加剂—", cat: "Feed Additive", href: "/zh/产品/赖氨酸硫酸盐-70-饲料级/", img: "/images/uploads/2025/09/1-768x768.jpg" },
  { title: "盐酸甜菜碱——饲料添加剂直供制造商—", cat: "Feed Additive", href: "/zh/产品/饲料级甜菜碱盐酸盐/", img: "/images/uploads/2025/08/IMG_0272-768x768.jpg" },
  { title: "维生素B12粉（甲钴胺）饲料添加剂—", cat: "Feed Additive", href: "/zh/产品/饲料级维生素-b12-粉剂甲钴胺/", img: "/images/uploads/2025/08/vitamin-b12-powder.jpg" }
];
---

<BaseLayout title={page.title} lang="zh-CN" description="Feed-grade additives for animal nutrition — choline chloride, betaine, dicalcium phosphate, amino acids, vitamins, and enzymes." canonical="/zh/产品/">
  <div class="container section">
    <span class="kicker">产品</span>
    <h1 class="sec-title">产品</h1>
    <p class="sec-sub">Feed-grade additives for animal nutrition.</p>

    <div class="card-grid">
      {products.map((p) => (
        <div class="card">
          <div class="thumb">
            <a href={p.href}><img src={p.img} alt={p.title} loading="lazy" width="400" height="300" /></a>
          </div>
          <div class="body">
            <span class="cat">{p.cat}</span>
            <h3><a href={p.href}>{p.title}</a></h3>
            <a class="link" href={p.href}>View details →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
