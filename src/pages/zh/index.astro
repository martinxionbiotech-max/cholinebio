---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Dinweys Biotech – 饲料添加剂出口与全球分销",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/'/>";
---

<BaseLayout title={page.title} hreflang={hreflang} lang="zh-CN" description="我们的合作生产设施拥有国际公认的质量和安全认证，包括 ISO 9001、ISO 22000、HACCP 和 FAMI-QS，用于饲料级添加剂的生产和出口合规性。" canonical="/zh/">
  <section class="hero">
    <div class="container">
      <h1>中国优质饲料添加剂供应商</h1>
      <p class="lead">鼎为生物技术有限公司是合格饲料添加剂制造商的全球销售与出口部门——为全球农场和饲料公司供应氯化胆碱、甜菜碱、磷酸二钙、氨基酸和维生素。</p>
      <div class="hero-actions">
        <a class="btn white" href="/zh/产品/">浏览产品</a>
        <a class="btn ghost-hero" href="/zh/联系/">获取报价</a>
      </div>
      <div class="hero-stats">
        <div><b>20+</b><span>出口国家</span></div>
        <div><b>100+</b><span>全球客户</span></div>
        <div><b>ISO·HACCP·FAMI-QS</b><span>认证工厂</span></div>
      </div>
    </div>
  </section>

  <div class="container">
    <!-- 产品分类 -->
    <section class="section">
      <span class="kicker">产品范围</span>
      <h2 class="sec-title">我们的饲料添加剂分类</h2>
      <p class="sec-sub">从氯化胆碱到饲料酶制剂——直接来自经认证的中国制造商，提供完整文件和出口支持。</p>
      <div class="card-grid">
        <div class="card">
          <div class="body">
            <span class="cat">维生素</span>
            <h3><a href="/product_category/choline-chloride/">氯化胆碱饲料</a></h3>
            <p>60% 玉米芯、60% 二氧化硅、50% 玉米芯和 75% 液体——用于家禽、猪和水产的核心维生素 B4 补充剂。</p>
            <a class="link" href="/product_category/choline-chloride/">查看产品 →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">维生素</span>
            <h3><a href="/product_category/vitamins/">维生素饲料粉</a></h3>
            <p>核黄素（B2）、抗坏血酸（C）等——用于平衡动物营养的饲料级维生素。</p>
            <a class="link" href="/product_category/vitamins/">查看产品 →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">矿物质</span>
            <h3><a href="/product_category/minerals-for-feed-and-food/">饲料矿物质</a></h3>
            <p>磷酸二钙（DCP 17% 与 18%）和矿物添加剂，用于骨骼发育和生产性能。</p>
            <a class="link" href="/product_category/minerals-for-feed-and-food/">查看产品 →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">氨基酸</span>
            <h3><a href="/product_category/amino-acids/">氨基酸饲料</a></h3>
            <p>L-赖氨酸硫酸盐 70%、DL-蛋氨酸、L-苏氨酸——优化饲料配方的必需氨基酸。</p>
            <a class="link" href="/product_category/amino-acids/">查看产品 →</a>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <span class="cat">酶制剂</span>
            <h3><a href="/product_category/enzyme-preparation/">饲料酶制剂</a></h3>
            <p>热稳定植酸酶和颗粒植酸酶，提高磷利用率和饲料效率。</p>
            <a class="link" href="/product_category/enzyme-preparation/">查看产品 →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 认证 -->
    <section class="section">
      <span class="kicker">质量保证</span>
      <h2 class="sec-title">经认证的制造商合作伙伴</h2>
      <p class="sec-sub">我们的合作工厂持有国际公认的饲料级添加剂生产质量和安全认证，符合出口合规要求。</p>
      <div class="cert-grid">
        <div class="cert-card">
          <div class="cert-img"><img src="/images/uploads/2025/12/ISO.png" alt="饲料添加剂制造商 ISO 9001" loading="lazy" /></div>
          <h3>ISO 9001</h3>
          <p>质量管理体系</p>
        </div>
        <div class="cert-card">
          <div class="cert-img"><img src="/images/uploads/2025/12/HACCP-1024x1024.png" alt="饲料添加剂制造商 HACCP" loading="lazy" /></div>
          <h3>HACCP</h3>
          <p>危害分析与关键控制点</p>
        </div>
        <div class="cert-card">
          <div class="cert-img"><img src="/images/uploads/2025/12/HSL.jpg" alt="饲料添加剂制造商 FAMI-QS" loading="lazy" /></div>
          <h3>FAMI-QS</h3>
          <p>饲料添加剂质量标准（欧洲）</p>
        </div>
      </div>
    </section>

    <!-- 为什么选择我们 -->
    <section class="section">
      <span class="kicker">为什么选择我们</span>
      <h2 class="sec-title">值得信赖的饲料添加剂采购合作伙伴</h2>
      <div class="card-grid">
        <div class="card">
          <div class="body">
            <h3>出口与沟通优势</h3>
            <p>合格饲料添加剂制造商指定的出口与销售合作伙伴，提供持续的国际交流和出口文件支持。</p>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3>产品与市场支持</h3>
            <p>在产品规格、监管信息和物流协调方面提供协助，让您专注于饲料配方。</p>
          </div>
        </div>
        <div class="card">
          <div class="body">
            <h3>可靠的全球交付</h3>
            <p>与合作工厂紧密合作，确保及时交付、清晰的出口程序和可靠的服务。</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- CTA -->
  <div class="container">
    <section class="cta-band">
      <h2>准备采购优质饲料添加剂？</h2>
      <p>获取氯化胆碱、甜菜碱、磷酸二钙、氨基酸和维生素的竞争性报价、COA 文件和可靠的出口物流。</p>
      <a class="btn" href="/zh/联系/">联系我们的销售团队</a>
    </section>
  </div>
</BaseLayout>
