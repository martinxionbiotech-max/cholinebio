---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "博客",
};
const hreflang = "<link rel='alternate' hreflang='en' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='x-default' href='https://cholinebio.com/blog/'/><link rel='alternate' hreflang='ar' href='https://cholinebio.com/ar/%d8%a7%d9%84%d9%85%d8%af%d9%88%d9%86%d8%a9/'/><link rel='alternate' hreflang='fr' href='https://cholinebio.com/fr/blog/'/><link rel='alternate' hreflang='tr' href='https://cholinebio.com/tr/blog/'/><link rel='alternate' hreflang='es' href='https://cholinebio.com/es/blog/'/><link rel='alternate' hreflang='de' href='https://cholinebio.com/de/blog/'/><link rel='alternate' hreflang='zh' href='https://cholinebio.com/zh/%e5%8d%9a%e5%ae%a2/'/><link rel='alternate' hreflang='pt' href='https://cholinebio.com/pt/blog/'/>";

const posts = [
  { title: "什么是氯化胆碱？中国是如何生产的？", href: "/zh/《氯化胆碱中国生产指南》是什么/" },
  { title: "饲料添加剂分类", href: "/zh/饲料添加剂分类/" },
  { title: "氯化胆碱饲料：购买前必须了解的5个关键点", href: "/zh/您必须知道的氯化胆碱饲料-5-大关键/" },
  { title: "胆碱和肌醇：用于动物饲料添加剂", href: "/zh/胆碱和肌醇/" },
  { title: "家禽饲料中的氯化胆碱——您需要了解的事项！", href: "/zh/家禽饲料中的氯化胆碱/" },
  { title: "猫粮中的氯化胆碱：基本功能、益处及其与犬类营养的对比", href: "/zh/猫粮中的氯化胆碱/" },
  { title: "狗粮中的氯化胆碱：功能、益处及注意事项", href: "/zh/狗粮中的氯化胆碱/" },
  { title: "什么是磷酸二钙？您不可或缺的最全面信息", href: "/zh/什么是磷酸二钙/" },
  { title: "什么是植物源饲料添加剂？氯化胆碱对比分析", href: "/zh/什么是植物性饲料添加剂/" },
  { title: "2025年中国氯化胆碱每吨价格：市场趋势与预测", href: "/zh/2025-年中国氯化胆碱每吨价格/" },
];
---

<BaseLayout title={page.title} hreflang={hreflang} lang="zh-CN" description="饲料添加剂行业洞察——氯化胆碱、磷酸二钙、维生素、氨基酸，以及动物营养的实用采购指南。" canonical="/zh/博客/">
  <div class="container section">
    <span class="kicker">博客</span>
    <h1 class="sec-title">饲料添加剂行业洞察</h1>
    <p class="sec-sub">关于氯化胆碱、磷酸二钙、维生素和氨基酸的实用指南与技术文章，服务动物营养行业。</p>

    <div class="card-grid">
      {posts.map((post) => (
        <div class="card plain">
          <div class="body">
            <h3><a href={post.href}>{post.title}</a></h3>
            <a class="link" href={post.href}>阅读文章 →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
