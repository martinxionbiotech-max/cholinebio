---
const year = new Date().getFullYear();
const currentLang = Astro.url.pathname.split("/")[1];
const LANG_CODES = ["ar", "fr", "tr", "es", "de", "zh", "pt"];
const isLangPage = LANG_CODES.includes(currentLang);
const prefix = isLangPage ? `/${currentLang}` : "";

// 快捷链接（slug 保持英文）
const links = [
  { label: "About", href: "/about/" },
  { label: "Products", href: "/product/" },
  { label: "Services", href: "/services/" },
  { label: "Blog", href: "/blog/" },
  { label: "FAQ", href: "/faq/" },
  { label: "Contact", href: "/contact/" },
  { label: "Privacy Policy", href: "/privacy-policy/" },
  { label: "Terms and Conditions", href: "/terms-and-conditions/" },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <div class="footer-brand">
        <img src="/images/uploads/2025/08/cropped-cropped-logo3.png" alt="Dinweys Biotech logo" width="142" height="60" loading="lazy" />
      </div>
      <p class="footer-tagline">Feed additive export &amp; global distribution partner</p>
    </div>

    <div class="footer-col">
      <h2>Quick Links</h2>
      <address>
        {links.map((l) => (
          <p><a href={`${prefix}${l.href}`}>{l.label}</a></p>
        ))}
      </address>
    </div>

    <div class="footer-col">
      <h2>Contact</h2>
      <address>
        <p><strong>Email:</strong> <a href="mailto:info@dinweys.com">info@dinweys.com</a></p>
        <p><strong>Phone / WhatsApp:</strong> +86 13610811901</p>
        <p><strong>Location:</strong> Anhui, China</p>
        <p><strong>Hours:</strong> Mon–Fri, 09:00–18:00 (CST)</p>
      </address>
    </div>
  </div>

  <div class="container">
    <p class="footer-disclaimer">
      Disclaimer: All products presented on this website are feed-grade additives intended exclusively
      for animal nutrition. They are not suitable for human consumption, food processing, or
      pharmaceutical applications. Please contact us separately if food- or pharma-grade materials
      are required.
    </p>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} Dinweys Biotech – Feed Additives Export &amp; Global Distribution</p>
    </div>
  </div>
</footer>
