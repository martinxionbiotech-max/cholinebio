---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  author?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  lang?: string;
  dir?: string;
  hreflang?: string;
}

const {
  title,
  description = "Dinweys Biotech is a dedicated global sales and export division for qualified feed additive manufacturers in China, specializing in choline chloride, betaine, dicalcium phosphate, amino acids, and vitamins for poultry, swine, ruminant, and aquaculture feed.",
  canonical,
  ogType = "website",
  ogImage = "/images/uploads/2025/08/cropped-cropped-logo3.png",
  jsonLd,
  author,
  datePublished,
  dateModified,
  noindex = false,
  lang = "en",
  dir = "ltr",
  hreflang,
} = Astro.props;

const SITE = "https://cholinebio.com";
const BRAND = "Dinweys Biotech";
const BRAND_SHORT = "Dinweys Biotech";

const cleanTitle = title.replace(/\u200b/gi, "").trim();
const hasBrand = cleanTitle.toUpperCase().includes("DINWEYS");
const baseTitle = cleanTitle || BRAND;
const fullTitle = hasBrand ? baseTitle : `${baseTitle} | ${BRAND_SHORT}`;

const canonicalUrl = canonical
  ? (canonical.startsWith("http") ? canonical : SITE + canonical)
  : SITE + Astro.url.pathname;

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const articleJsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: cleanTitle,
        description,
        image: ogImage.startsWith("http") ? ogImage : SITE + ogImage,
        author: author
          ? { "@type": "Person", name: author }
          : { "@type": "Organization", name: BRAND },
        publisher: { "@id": SITE + "/#organization" },
        datePublished,
        dateModified: dateModified || datePublished,
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl }
      }
    : null;

const productJsonLd =
  ogType === "product"
    ? {
        "@context": "https://schema.org",
        "@type": "Product",
        name: cleanTitle,
        description,
        image: ogImage.startsWith("http") ? ogImage : SITE + ogImage,
        brand: { "@type": "Brand", name: BRAND_SHORT },
        manufacturer: { "@id": SITE + "/#organization" },
        url: canonicalUrl
      }
    : null;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": SITE + "/#organization",
  name: BRAND,
  url: SITE,
  logo: SITE + "/images/uploads/2025/08/cropped-cropped-logo3.png",
  email: "info@dinweys.com",
  telephone: "+86 13610811901",
  address: {
    "@type": "PostalAddress",
    addressRegion: "Anhui",
    addressCountry: "CN"
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "info@dinweys.com",
    telephone: "+86 13610811901",
    areaServed: "Worldwide",
    availableLanguage: ["English", "Chinese", "Arabic", "French", "Turkish", "Spanish", "German", "Portuguese"]
  },
  areaServed: "Worldwide",
  knowsAbout: [
    "Choline chloride",
    "Betaine",
    "Dicalcium phosphate",
    "Amino acids",
    "Vitamins",
    "Feed enzymes",
    "Phytase"
  ]
};

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE + "/#website",
  url: SITE,
  name: BRAND,
  publisher: { "@id": SITE + "/#organization" }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: SITE + "/"
    },
    ...(canonicalUrl !== SITE + "/"
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: cleanTitle,
            item: canonicalUrl
          }
        ]
      : [])
  ]
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {hreflang && <Fragment set:html={hreflang} />}
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    {author && <meta name="author" content={author} />}

    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : lang} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith("http") ? ogImage : SITE + ogImage} />

    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <link rel="icon" type="image/png" href="/images/uploads/2025/08/cropped-cropped-logo3.png" />

    {jsonLdArray.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    {articleJsonLd && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />}
    {productJsonLd && <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
